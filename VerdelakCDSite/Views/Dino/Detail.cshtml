@model DinoDetailViewModel

@{
    ViewData["Title"] = Model.Dinosaur?.CommonName ?? "Dino Details";
}

<div class="mb-4">
    <a class="btn btn-outline-secondary" asp-controller="Dino" asp-action="Index">Back to Dino archive</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Dinosaur is not null)
{
    var dino = Model.Dinosaur;
    var primaryImage = dino.Illustrations.FirstOrDefault() ?? (!string.IsNullOrWhiteSpace(dino.PrimaryImageUrl)
        ? new PublicDinoIllustration { ImageUrl = dino.PrimaryImageUrl, Caption = dino.PrimaryImageCaption }
        : null);

    <section class="border rounded-3 bg-white overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-lg-7 p-4 p-lg-5">
                <p class="text-uppercase fw-semibold text-success mb-2">Dino Archive Entry</p>
                <h1 class="display-5 fw-semibold mb-2">@dino.CommonName</h1>
                <p class="lead fst-italic text-secondary mb-3">@dino.ScientificName</p>
                @if (!string.IsNullOrWhiteSpace(dino.Description))
                {
                    <p class="fs-5 mb-0">@dino.Description</p>
                }
            </div>
            <div class="col-lg-5">
                @if (primaryImage is not null)
                {
                    <figure class="h-100 mb-0">
                        <img class="dino-detail-hero-image" src="@primaryImage.ImageUrl" alt="@(primaryImage.Caption ?? dino.CommonName)" />
                        @if (!string.IsNullOrWhiteSpace(primaryImage.Caption) || !string.IsNullOrWhiteSpace(primaryImage.Credit))
                        {
                            <figcaption class="small text-secondary p-3">
                                @primaryImage.Caption
                                @if (!string.IsNullOrWhiteSpace(primaryImage.Credit))
                                {
                                    <span>Credit: @primaryImage.Credit</span>
                                }
                            </figcaption>
                        }
                    </figure>
                }
            </div>
        </div>
    </section>

    <section class="row g-4 align-items-start">
        <aside class="col-lg-4 col-xl-3">
            <div class="position-lg-sticky">
                <div class="border rounded-3 bg-white p-3 shadow-sm mb-3">
                    <h2 class="h5 mb-3">Classification</h2>
                    @if (dino.Classification.Count == 0)
                    {
                        <p class="text-secondary mb-0">Classification not set.</p>
                    }
                    else
                    {
                        <dl class="mb-0">
                            @foreach (var row in dino.Classification)
                            {
                                <div class="d-flex justify-content-between gap-3 border-bottom py-2">
                                    <dt class="small text-secondary">@row.Rank</dt>
                                    <dd class="small fw-semibold mb-0 text-end">@row.Name</dd>
                                </div>
                            }
                        </dl>
                    }
                </div>

                <div class="border rounded-3 bg-white p-3 shadow-sm">
                    <h2 class="h5 mb-3">Discovery</h2>
                    <dl class="mb-0">
                        <div class="border-bottom py-2">
                            <dt class="small text-secondary">Date</dt>
                            <dd class="fw-semibold mb-0">@(dino.DiscoveryDate ?? "Not listed")</dd>
                        </div>
                        <div class="py-2">
                            <dt class="small text-secondary">Discovered by</dt>
                            <dd class="fw-semibold mb-0">@(dino.DiscoveredBy ?? "Not listed")</dd>
                        </div>
                    </dl>
                    @if (dino.Clades.Count > 0)
                    {
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            @foreach (var clade in dino.Clades)
                            {
                                <span class="badge rounded-pill text-bg-light">@clade</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </aside>

        <div class="col-lg-8 col-xl-9">
            <section class="mb-4">
                <h2 class="h3 mb-3">Notes</h2>
                @if (dino.Sections.Count == 0)
                {
                    <div class="border rounded-3 bg-white p-4 text-secondary">No text sections have been published for this entry yet.</div>
                }
                else
                {
                    <div class="vstack gap-3">
                        @foreach (var contentSection in dino.Sections)
                        {
                            <article class="border rounded-3 bg-white p-4">
                                <h3 class="h5">@contentSection.Heading</h3>
                                <p class="mb-0">@contentSection.Body</p>
                            </article>
                        }
                    </div>
                }
            </section>

            <section>
                <h2 class="h3 mb-3">Illustrations</h2>
                @if (dino.Illustrations.Count == 0)
                {
                    <div class="border rounded-3 bg-white p-4 text-secondary">No illustrations have been published for this entry yet.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var image in dino.Illustrations)
                        {
                            <div class="col-md-6">
                                <figure class="dino-illustration-card h-100 border rounded-3 bg-white overflow-hidden mb-0">
                                    <img class="dino-illustration-image" src="@image.ImageUrl" alt="@(image.Caption ?? dino.CommonName)" />
                                    @if (!string.IsNullOrWhiteSpace(image.Caption) || !string.IsNullOrWhiteSpace(image.Credit))
                                    {
                                        <figcaption class="small text-secondary p-3">
                                            @image.Caption
                                            @if (!string.IsNullOrWhiteSpace(image.Credit))
                                            {
                                                <span>Credit: @image.Credit</span>
                                            }
                                        </figcaption>
                                    }
                                </figure>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </section>
}
