@model CdCatalogViewModel

@{
    ViewData["Title"] = "CD Collection";
    var search = Model.SearchTerm?.Trim();
    var activeIndexKey = string.IsNullOrWhiteSpace(search)
        ? string.Empty
        : char.IsDigit(search[0])
            ? "number"
            : char.IsLetter(search[0])
                ? char.ToUpperInvariant(search[0]).ToString().ToLowerInvariant()
                : string.Empty;
}

<section class="catalog-hero py-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase fw-semibold site-accent mb-2">@Model.Appearance.BrandName</p>
            <h1 class="display-5 fw-semibold mb-3">@Model.Appearance.Tagline</h1>
            <p class="lead text-secondary mb-4">
                Search for a band, scan the albums in the collection, and open any CD to see details and reviews.
            </p>
            <form class="row g-2" asp-controller="Home" asp-action="Index" method="get">
                <div class="col-sm-8">
                    <label class="visually-hidden" for="band">Band name</label>
                    <input class="form-control form-control-lg" id="band" name="band" value="@Model.SearchTerm" placeholder="Search by band" />
                </div>
                <div class="col-sm-4 d-grid">
                    <button class="btn btn-primary btn-lg" type="submit">Search</button>
                </div>
            </form>
        </div>
        <div class="col-lg-5">
            @if (!string.IsNullOrWhiteSpace(Model.Appearance.HeroImageUrl))
            {
                <img class="catalog-hero-image mb-3" src="@Model.Appearance.HeroImageUrl" alt="@($"{Model.Appearance.BrandName} hero image")" />
            }
            <div class="border rounded-3 p-4 bg-white shadow-sm">
                <p class="text-secondary mb-1">Collection snapshot</p>
                <div class="d-flex align-items-end gap-4">
                    <div>
                        <div class="display-6 fw-semibold">@Model.TotalAlbumCount</div>
                        <div class="text-secondary">CDs found</div>
                    </div>
                    <div>
                        <div class="display-6 fw-semibold">@Model.TotalArtistCount</div>
                        <div class="text-secondary">Bands found</div>
                    </div>
                </div>
                @if (Model.HasSearch)
                {
                    <a class="btn btn-outline-secondary mt-4" asp-controller="Home" asp-action="Index">Clear search</a>
                }
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4 align-items-start">
    <aside class="col-lg-3">
        <div class="artist-index position-lg-sticky">
            <div class="border rounded-3 bg-white shadow-sm">
                <div class="p-3 border-bottom">
                    <h2 class="h5 mb-1">Band Index</h2>
                    <p class="text-secondary small mb-0">Expand a letter, then choose a band.</p>
                </div>
                <div class="accordion accordion-flush" id="artistIndex">
                    @foreach (var group in Model.ArtistIndex)
                    {
                        var panelId = $"artist-index-{group.Key}";
                        var headingId = $"artist-index-heading-{group.Key}";
                        var isActive = group.Key == activeIndexKey;

                        <div class="accordion-item">
                            <h3 class="accordion-header" id="@headingId">
                                <button class="accordion-button py-2 @(isActive ? "" : "collapsed")"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@panelId"
                                        aria-expanded="@(isActive ? "true" : "false")"
                                        aria-controls="@panelId">
                                    <span class="fw-semibold">@group.Label</span>
                                    <span class="badge text-bg-light ms-2">@group.Artists.Count</span>
                                </button>
                            </h3>
                            <div id="@panelId"
                                 class="accordion-collapse collapse @(isActive ? "show" : "")"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#artistIndex">
                                <div class="accordion-body py-2">
                                    @if (group.Artists.Count == 0)
                                    {
                                        <p class="text-secondary small mb-0">No bands.</p>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var artist in group.Artists)
                                            {
                                                <a class="list-group-item list-group-item-action px-0 py-1 small"
                                                   asp-controller="Home"
                                                   asp-action="Index"
                                                   asp-route-band="@artist.Artist">
                                                    @artist.Artist
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>

    <section class="col-lg-9 py-4 py-lg-0">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
            <div>
                <h2 class="h3 mb-1">CDs By Band</h2>
                <p class="text-secondary mb-0">
                    <span>
                        Page @Model.PageNumber of @Model.TotalPages
                        @if (Model.HasSearch)
                        {
                            <span>for bands matching "@Model.SearchTerm"</span>
                        }
                        else
                        {
                            <span>of the public CD collection</span>
                        }
                    </span>
                </p>
            </div>
        </div>

        @if (Model.Artists.Count == 0 && string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="border rounded-3 bg-white p-4 text-secondary">No bands matched that search.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var artist in Model.Artists)
                {
                    <div class="col-xl-6">
                        <article class="catalog-card h-100 border rounded-3 bg-white p-3">
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                <h3 class="h5 mb-0">@artist.Artist</h3>
                                <span class="badge text-bg-light">@artist.Albums.Count CDs</span>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var album in artist.Albums)
                                {
                                    <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3 px-0"
                                       asp-controller="Home"
                                       asp-action="Album"
                                       asp-route-id="@album.Id">
                                        <span>@album.Title</span>
                                        <span class="text-primary small">Reviews</span>
                                    </a>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>

            <nav class="d-flex justify-content-between align-items-center mt-4" aria-label="CD catalog pages">
                @if (Model.HasPreviousPage)
                {
                    <a class="btn btn-outline-secondary"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-band="@Model.SearchTerm"
                       asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                }
                else
                {
                    <span></span>
                }

                <span class="text-secondary small">Showing @Model.Artists.Count of @Model.TotalArtistCount bands</span>

                @if (Model.HasNextPage)
                {
                    <a class="btn btn-outline-secondary"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-band="@Model.SearchTerm"
                       asp-route-page="@(Model.PageNumber + 1)">Next</a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        }
    </section>
</div>
